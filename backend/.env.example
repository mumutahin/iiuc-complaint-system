# Copy this file to `.env` in this same folder and fill in real values.
# Never commit the real `.env` file — it's already in .gitignore.

# ── Server ──────────────────────────────────────────────────────────────
PORT=5000
# Comma-separated list of frontend URLs allowed to call this API.
# Add your two deployed Vercel URLs here once you have them, e.g.:
# CORS_ORIGINS=https://iiuc-student.vercel.app,https://iiuc-admin.vercel.app
CORS_ORIGINS=

# ── MongoDB Atlas ───────────────────────────────────────────────────────
# Atlas → Database → Connect → Drivers → copy the connection string,
# then replace <password> and add your database name before the "?".
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster_name>.xxxxx.mongodb.net/iiuc_complaints?appName=<cluster_name>

# ── Firebase Admin SDK ──────────────────────────────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new
# private key. That downloads a JSON file — pull THREE values out of it:
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Paste the "private_key" value exactly as-is, keeping the \n sequences
# and the surrounding quotes:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"
#
# ALTERNATIVE (use this INSTEAD of the three vars above if your hosting
# provider's dashboard mangles multi-line values): base64-encode the
# entire downloaded JSON file and paste the result here.
#   macOS/Linux: base64 -i serviceAccountKey.json | tr -d '\n'
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("serviceAccountKey.json"))
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# ── Cloudinary (image uploads) ──────────────────────────────────────────
# Cloudinary Dashboard → these three values are shown right at the top.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Email notifications (OPTIONAL — leave blank to disable safely) ──────
# Using Gmail: you need a 16-character "App Password", NOT your normal
# Gmail password (Google Account → Security → 2-Step Verification →
# App passwords). Any other SMTP provider works too.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
