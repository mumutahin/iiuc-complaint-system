# ── Backend API ─────────────────────────────────────────────────────────
# Local development (backend running via `npm run dev`):
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Once the backend is deployed on Render, switch these to something like:
# VITE_API_URL=https://iiuc-complaint-backend.onrender.com/api
# VITE_SOCKET_URL=https://iiuc-complaint-backend.onrender.com

# ── Firebase (Web app config) ────────────────────────────────────────────
# Firebase Console → Project settings → General → "Your apps" → Web app
# → click the </> icon if you haven't registered a web app yet.
# These values are PUBLIC by design (they identify the project, they are
# not secrets) — it's normal and safe for them to end up in the built
# frontend bundle.
