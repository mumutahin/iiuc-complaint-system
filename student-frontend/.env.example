# Copy this file to `.env` in this same folder and fill in real values.

# ── Backend API ─────────────────────────────────────────────────────────
# Local development (backend running via `npm run dev`):
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# Once the backend is deployed on Render, switch these to something like:
# VITE_API_URL=https://iiuc-complaint-backend.onrender.com/api
# VITE_SOCKET_URL=https://iiuc-complaint-backend.onrender.com

# ── Firebase (Web app config) ────────────────────────────────────────────
# Firebase Console → Project settings → General → "Your apps" → Web app
# → click the </> icon if you haven't registered a web app yet.
# These values are PUBLIC by design (they identify the project, they are
# not secrets) — it's normal and safe for them to end up in the built
# frontend bundle.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Staff portal link (used by the "I'm Staff" button on the landing page) ──
# The deployed URL of admin-frontend. Leave blank locally if you're not
# running the admin app side by side — the button just does nothing.
VITE_ADMIN_APP_URL=https://your-admin-app.vercel.app
