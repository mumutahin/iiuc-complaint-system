# Copy this file to `.env` in this same folder and fill in real values.
# These should be the SAME Firebase project values as student-frontend's
# .env — students and staff sign into one shared Firebase project; only
# their `role` field in MongoDB differs.

# ── Backend API ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000/api
VITE_SOCKET_URL=http://localhost:5000
# VITE_API_URL=https://iiuc-complaint-backend.onrender.com/api
# VITE_SOCKET_URL=https://iiuc-complaint-backend.onrender.com

# ── Firebase (Web app config) — same project as student-frontend ────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ── Student portal link (used by the "Not staff?" link on this login page) ──
VITE_STUDENT_APP_URL=https://your-student-app.vercel.app